# Copy this file to .env to use these optional model and voice settings.
# Set OPENAI_API_KEY in the Windows environment, never here.
ENGLISH_LIVE_MODEL=gpt-live-1
ENGLISH_TEACHER_MODEL=gpt-6-luna
ENGLISH_TEACHER_REASONING_EFFORT=medium
ENGLISH_TRANSCRIPTION_MODEL=gpt-transcribe
ENGLISH_VOICE=marin
