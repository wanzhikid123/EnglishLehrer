# Copy to .env and restart after changes. Process environment takes precedence.
ENGLISH_LIVE_MODEL=gpt-live-1
ENGLISH_TEACHER_MODEL=gpt-5.6-terra
ENGLISH_IMAGE_MODEL=gpt-image-2.5-flare
ENGLISH_TRANSCRIPTION_MODEL=gpt-transcribe
ENGLISH_VOICE=marin
# OPENAI_API_KEY / openai_api_key is read only from the process environment.
